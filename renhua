#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""renhua —— AI 腔浓度检测器（说人话 / shuo-renhua）

用法:
    renhua check <file.md>            检测单个文件，输出评分 + 病灶清单
    renhua check <file.md> --json     机器可读输出（agent 用）
    renhua check <file.md> --fix-hints 输出带修复建议的完整报告
    renhua rules                      列出全部病灶规则

评分 (0-100):
    0-24   人味（基本没有 AI 腔）
    25-44  轻度（偶尔露馅）
    45-69  中度（一眼 AI）
    70-100 重度（AI 腔晚期）

零第三方依赖，Python 3.8+。
"""
import json
import math
import os
import re
import sys
import unicodedata

RULES_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "rules", "patterns.txt")


# ---------------------------------------------------------------- 规则加载

def load_rules(path=RULES_PATH):
    rules = []
    with open(path, encoding="utf-8") as f:
        for lineno, line in enumerate(f, 1):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = [p.strip() for p in line.split("||")]
            if len(parts) != 8:
                raise ValueError("rules 第 %d 行字段数不是 8：%r" % (lineno, line))
            rid, name, cat, sev, pattern, fix, bad, good = parts
            rules.append({
                "id": rid, "name": name, "category": cat,
                "severity": int(sev), "fix": fix, "bad": bad, "good": good,
                "regex": re.compile(pattern, re.MULTILINE),
            })
    return rules


# ---------------------------------------------------------------- 文本统计规则（非正则类病灶）

def _sentences(text):
    sents = re.split(r"[。！？!?…\n]+", text)
    return [s.strip() for s in sents if len(s.strip()) >= 2]


def _paragraphs(text):
    paras = [p.strip() for p in re.split(r"\n\s*\n", text) if p.strip()]
    return paras


def statistical_findings(text):
    """节奏类病灶：等长句、等长段。AI 的句子像切好的，人的句子忽长忽短。"""
    findings = []
    sents = [len(s) for s in _sentences(text)]
    if len(sents) >= 6:
        mean = sum(sents) / len(sents)
        var = sum((x - mean) ** 2 for x in sents) / len(sents)
        cv = math.sqrt(var) / mean if mean else 0  # 变异系数
        if cv < 0.35:
            findings.append({
                "rule": "equal-sentence-length", "name": "句子等长症",
                "category": "rhythm", "severity": 2,
                "hits": 1, "lines": [],
                "detail": "句长变异系数 %.2f（人类通常 > 0.45）。长句铺陈、短句收尾，节奏要像说话。" % cv,
                "fix": "把几句拆短、几句合并，制造长短交错",
            })
    paras = [len(p) for p in _paragraphs(text)]
    if len(paras) >= 4:
        mean = sum(paras) / len(paras)
        var = sum((x - mean) ** 2 for x in paras) / len(paras)
        cv = math.sqrt(var) / mean if mean else 0
        if cv < 0.3:
            findings.append({
                "rule": "equal-paragraph-size", "name": "段落均匀症",
                "category": "rhythm", "severity": 1,
                "hits": 1, "lines": [],
                "detail": "段落长度变异系数 %.2f。每段一样长是生成的节奏。" % cv,
                "fix": "让有分量的段落长，收尾的段落短到一两句",
            })
    return findings


# ---------------------------------------------------------------- 检测主逻辑

def strip_code_blocks(text):
    """把 ``` 围起来的代码块换成等长空白（保留换行，保持行号），终端输出和代码不算文章腔调。"""
    text = re.sub(r"```.*?```", lambda m: re.sub(r"[^\n]", " ", m.group(0)), text, flags=re.DOTALL)
    return re.sub(r"`[^`\n]+`", lambda m: re.sub(r"\S", " ", m.group(0)), text)  # 行内代码


def strip_quotes(text):
    """把 > 引用块换成等长空白。写讨论型文章（引用坏例）时用 --strip-quotes 豁免。"""
    return re.sub(r"^\s*>.*$", lambda m: re.sub(r"\S", " ", m.group(0)), text, flags=re.MULTILINE)


def _line_of_offset(text, offset):
    return text.count("\n", 0, offset) + 1


def analyze(text, rules, skip_code=True, skip_quotes=False):
    if skip_code:
        text = strip_code_blocks(text)
    if skip_quotes:
        text = strip_quotes(text)
    hits = []
    for rule in rules:
        found = []
        for m in rule["regex"].finditer(text):
            found.append({"match": m.group(0)[:40], "line": _line_of_offset(text, m.start())})
        if found:
            hits.append({
                "rule": rule["id"], "name": rule["name"], "category": rule["category"],
                "severity": rule["severity"], "hits": len(found),
                "lines": [f["line"] for f in found],
                "samples": [f["match"] for f in found[:3]],
                "fix": rule["fix"], "bad": rule["bad"], "good": rule["good"],
            })

    plain = re.sub(r"\s+", "", text)
    n_chars = max(len(plain), 1)
    # 权重表：重度病灶平方主导，轻度病灶减半——单个破折号不该把人拉下水
    w = {1: 0.5, 2: 4.0, 3: 9.0}
    stat = statistical_findings(text)
    weighted = sum(w[h["severity"]] * h["hits"] for h in hits) + \
               sum(w[h["severity"]] * h["hits"] for h in stat)
    if n_chars < 50:
        return None, hits + stat, n_chars  # 文本太短，不评分
    density = weighted / (n_chars / 1000.0)
    # K=6 校准：典型 AI 文 ≈ 70-95，普通人类文章 ≈ 5-25
    score = min(100, round(density * 6))
    return score, hits + stat, n_chars


def _grade(score):
    if score < 25: return "人味"
    if score < 45: return "轻度 AI 腔"
    if score < 70: return "中度 AI 腔"
    return "重度 AI 腔"


# ---------------------------------------------------------------- 输出

SEV_MARK = {3: "!!!", 2: " !!", 1: "  ~"}


def report(path, as_json=False, with_fix=False, strip_quotes=False):
    with open(path, encoding="utf-8") as f:
        text = f.read()
    rules = load_rules()
    score, hits, n_chars = analyze(text, rules, skip_quotes=strip_quotes)
    hits.sort(key=lambda h: (-h["severity"], -h["hits"]))

    if as_json:
        return json.dumps({
            "file": path, "score": score,
            "grade": _grade(score) if score is not None else "文本太短，不评分",
            "chars": n_chars, "findings": hits,
        }, ensure_ascii=False, indent=2)

    out = []
    out.append("─" * 52)
    if score is None:
        out.append("AI 腔浓度：  --  （文本短于 50 字，不评分）")
    else:
        out.append("AI 腔浓度：%3d / 100   %s" % (score, _grade(score)))
        out.append("字数 %d ｜ 病灶 %d 类共 %d 处" % (n_chars, len(hits), sum(h["hits"] for h in hits)))
    out.append("─" * 52)
    for h in hits:
        out.append("%s [%s] %s ×%d  (行 %s)" % (
            SEV_MARK[h["severity"]], h["category"], h["name"], h["hits"],
            ",".join(map(str, h["lines"][:6])) + ("…" if len(h["lines"]) > 6 else "")))
        if h.get("samples"):
            out.append("      ↳ 命中：%s" % " ｜ ".join('「%s」' % s for s in h["samples"][:3]))
        if with_fix:
            out.append("      ↳ 修法：%s" % h["fix"])
            if h.get("bad"):
                out.append("      ↳ 坏例：%s" % h["bad"])
                out.append("      ↳ 好例：%s" % h["good"])
    if not hits:
        out.append("没发现病灶。这段文字像人写的。")
    out.append("─" * 52)
    return "\n".join(out)


def main(argv):
    if len(argv) >= 2 and argv[1] == "rules":
        rules = load_rules()
        print("%-22s %-14s %-10s %s" % ("ID", "病灶名", "类别/严重度", "修复方向"))
        for r in rules:
            print("%-22s %-14s %-4s/%d   %s" % (r["id"], r["name"], r["category"], r["severity"], r["fix"]))
        return 0
    if len(argv) < 3 or argv[1] != "check":
        print(__doc__)
        return 0 if len(argv) < 2 else 2
    path = argv[2]
    if not os.path.isfile(path):
        print("找不到文件：%s" % path, file=sys.stderr)
        return 2
    as_json = "--json" in argv
    with_fix = "--fix-hints" in argv
    strip_q = "--strip-quotes" in argv
    print(report(path, as_json, with_fix, strip_q))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
